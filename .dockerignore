# Only the code, migrations, lock file and the public dev golden set (with its recorded
# questions, for the daily refresh's retrieval check) go into the image: no secrets, no data.
.env
.env.*
!.env.example
private/
data/
evals/*
!evals/golden.dev.jsonl
!evals/queries.dev.json
tests/
docs/
.git/
.github/
.venv/
**/__pycache__/
.pytest_cache/
.ruff_cache/
mlruns/
*.tfvars
.terraform/

# The web app is built inside the image from its sources and lock file
web/node_modules/
web/dist/
