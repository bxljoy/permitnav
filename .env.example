# Copy to .env and fill in. Never commit .env.

# Local Postgres from docker-compose.yml
DATABASE_URL=postgresql://permitnav:permitnav@localhost:5432/permitnav

# LLM through OpenRouter during development (D15)
OPENROUTER_API_KEY=
ANSWER_MODEL=anthropic/claude-haiku-5.5   # Claude Haiku 5.5 on OpenRouter (D15)
# ANSWER_REASONING_EFFORT=               # none|minimal|low; unset: the model's default (kept: see DESIGN.md)
# ANSWER_STRUCTURED=                     # 1|true: hold the reply to a JSON Schema; unset: free text (kept off: see DESIGN.md)
# ANSWER_RULING_NOTES=                  # 1|true: show a ruling's passage with notes on which part of the ruling it is; unset: off (built, not yet switched on: see DESIGN.md)
# TRANSLATE_MODEL=                        # query translation (phase 2); defaults to ANSWER_MODEL
JUDGE_MODEL=google/gemini-3.5-flash-lite   # calibrated judge (slice 7, D19)
JUDGE_REASONING_EFFORT=low

# Embeddings, self-hosted (D15)
EMBEDDING_MODEL=BAAI/bge-m3

# Crawler
RAW_DIR=data/raw            # raw downloads (git-ignored)
CRAWLER_CONTACT=            # optional contact address added to the crawler's User-Agent

# HTTP API (phase 3). Every /ask request needs `Authorization: Bearer <API_TOKEN>`.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
# PERMITNAV_ALLOW_NO_AUTH=1   # local only: run the API without a token
# A second token, for the maintainer only (32 characters or more, different from API_TOKEN).
# Questions sent with it are traced WITH their text and labelled "maintainer"; everyone
# else's stay metadata only. Leave it unset and nobody's text is recorded.
# MAINTAINER_TOKEN=

# Tracing (phase 3): OpenTelemetry to Langfuse Cloud, EU region. Leave the keys empty to
# turn it off. The API and `ask` trace metadata only (fixed in code; MAINTAINER_TOKEN above
# is the one exception); eval runs, which ask golden-set questions only, record the full text.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com   # the EU region (default)
# Online evals: the share of the site's answers (0 to 1) that the eval judge (JUDGE_MODEL)
# checks against their sources after they have gone out. Unset: none. Each judged answer
# costs about as much again as the answer, and sends the question, answer and sources to
# the judge's provider too: decide again before other people use the site.
# LIVE_JUDGE_SHARE=1
# A shadow judge (off unless SHADOW_JUDGE_MODEL is set; needs LIVE_JUDGE_SHARE): a second
# judge asked about the same answer after the deployed one, to compare them before a switch.
# Only for questions asked with MAINTAINER_TOKEN; changes no score and nothing a person
# sees. Stops by itself at the limit or the budget. `permitnav shadow report` is the review;
# `permitnav shadow clear --yes` removes its rows afterwards.
# SHADOW_JUDGE_MODEL=google/gemini-3.8-flash
# SHADOW_JUDGE_REASONING_EFFORT=low
# SHADOW_JUDGE_LIMIT=100                   # answers
# SHADOW_JUDGE_BUDGET_USD=1                # dollars in all
# PERMITNAV_TRACE_FILE=data/traces.jsonl     # also write spans to a local file
# PERMITNAV_ENV=development                  # development | production
# DAILY_SPEND_CAP_USD=5                    # the API declines questions once a day's model spend reaches this; unset: no cap
