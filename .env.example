# Copy to .env and fill in. Never commit .env.

# Local Postgres from docker-compose.yml
DATABASE_URL=postgresql://permitnav:permitnav@localhost:5432/permitnav

# LLM through OpenRouter during development (D15)
OPENROUTER_API_KEY=
ANSWER_MODEL=anthropic/claude-haiku-5.5   # Claude Haiku 5.5 on OpenRouter (D15)
# TRANSLATE_MODEL=                        # query translation (phase 2); defaults to ANSWER_MODEL
JUDGE_MODEL=google/gemini-3.5-flash-lite   # calibrated judge (slice 7, D19)
JUDGE_REASONING_EFFORT=low

# Embeddings, self-hosted (D15)
EMBEDDING_MODEL=BAAI/bge-m3

# Crawler
RAW_DIR=data/raw            # raw downloads (git-ignored)
CRAWLER_CONTACT=            # optional contact address added to the crawler's User-Agent

# HTTP API (phase 3). Every /ask request needs `Authorization: Bearer <API_TOKEN>`.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
# PERMITNAV_ALLOW_NO_AUTH=1   # local only: run the API without a token
